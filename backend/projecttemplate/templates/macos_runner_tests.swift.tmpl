import Cocoa
import FlutterMacOS
import XCTest

@testable import {{.ProjectName}}

final class RunnerTests: XCTestCase {
  func testSecondaryTerminationAcknowledgesBeforeTerminatingApplication() {
    var events = [String]()
    let handler = BridraApplicationLifecycleHandler {
      events.append("terminate")
    }

    handler.handle(
      FlutterMethodCall(methodName: "terminateSecondary", arguments: nil)
    ) { result in
      XCTAssertNil(result)
      events.append("result")
    }

    XCTAssertEqual(events, ["result", "terminate"])
  }

  func testUnknownLifecycleMethodDoesNotTerminateApplication() {
    var terminated = false
    var receivedResult: Any?
    let handler = BridraApplicationLifecycleHandler {
      terminated = true
    }

    handler.handle(
      FlutterMethodCall(methodName: "unknown", arguments: nil)
    ) { result in
      receivedResult = result
    }

    XCTAssertTrue((receivedResult as? NSObject) === FlutterMethodNotImplemented)
    XCTAssertFalse(terminated)
  }
}
