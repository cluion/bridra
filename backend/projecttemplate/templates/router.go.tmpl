package app

import (
	"fmt"
	"io"

	"{{.BridraGoModule}}/framework"
	"{{.GoModule}}/app/contracts"
	"{{.GoModule}}/app/controllers"
	"{{.GoModule}}/app/services"
)

func NewRouter(token string, logs io.Writer, runtime string) *framework.Router {
	application, err := Build(Config{Token: token, Logs: logs, Runtime: runtime})
	if err != nil {
		panic(fmt.Errorf("app: build: %w", err))
	}
	return application.Router()
}

func NewRouterWithFileTransfers(
	token string,
	logs io.Writer,
	runtime string,
	fileTransfers *framework.FileTransferStore,
) *framework.Router {
	application, err := Build(Config{
		Token: token, Logs: logs, Runtime: runtime, FileTransfers: fileTransfers,
	})
	if err != nil {
		panic(fmt.Errorf("app: build: %w", err))
	}
	return application.Router()
}

func configureRouter(
	router *framework.Router,
	token string,
	logs io.Writer,
	runtime string,
) {
	greetingService := services.NewGreetingService()
	greetingController := controllers.NewGreetingController(greetingService)
	systemController := controllers.NewSystemController(runtime)

	middlewares := []framework.Middleware{
		framework.Traced("recovery", framework.Recovery()),
		framework.Traced("request-id", framework.RequireRequestID()),
		framework.Traced("auth", framework.Authenticate(token)),
	}
	if logs != nil {
		middlewares = append(
			[]framework.Middleware{
				framework.Traced("logging", framework.LogRequests(logs)),
			},
			middlewares...,
		)
	}
	router.Use(middlewares...)
	router.Handle(contracts.MethodSystemHealth, systemController.Health)
	router.Handle(contracts.MethodGreetingHello, greetingController.Hello)
}
