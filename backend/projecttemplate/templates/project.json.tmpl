{
  "schemaVersion": {{if eq .UI "flutter"}}3{{else}}4,
  "ui": {"mode": "web", "preset": {{quote .UI}}, "dist": "frontend/dist"}{{end}},
  "projectName": "{{.ProjectName}}",
  "goModule": "{{.GoModule}}",
  "frameworkModule": "{{.BridraGoModule}}",
  "frameworkVersion": "{{.FrameworkVersion}}",
  "templateVersion": {{.TemplateVersion}},
  "protocolVersion": {{.ProtocolVersion}},
  "platforms": [{{range $index, $platform := .Platforms}}{{if $index}}, {{end}}{{quote $platform}}{{end}}]
}
