class ExitingBackend extends FakeBackend {
  @override
  Future<GreetingResult> greet(
    GreetingRequest request, {
    Duration timeout = const Duration(seconds: 5),
    RpcCancellationToken? cancellationToken,
  }) async {
    throw const BackendClosedException();
  }
}

void main() {
  testWidgets(
    'places the macOS app name and toolbar beside native window controls',
    (tester) async {
      tester.view.physicalSize = const Size(600, 700);
      tester.view.devicePixelRatio = 1;
      addTearDown(tester.view.resetPhysicalSize);
      addTearDown(tester.view.resetDevicePixelRatio);
      await tester.pumpWidget(StarterApp(connector: () async => FakeBackend()));
      await tester.pumpAndSettle();
      expect(
        tester.getTopLeft(find.text({{dartString .DisplayName}})).dx,
        greaterThanOrEqualTo(88),
      );
      expect(
        tester.getTopLeft(find.byKey(const Key('navigation-back'))).dx,
        greaterThan(tester.getTopLeft(find.text({{dartString .DisplayName}})).dx),
      );
      final row = find.byKey(const Key('toolbar-row'));
      expect(tester.getSize(row).height, 56);
      for (final key in [
        'toolbar-product-name',
        'navigation-back',
        'navigation-forward',
        'sidebar-toggle',
        'toolbar-page-title',
      ]) {
        expect(
          tester.getCenter(find.byKey(Key(key))).dy,
          tester.getCenter(row).dy,
        );
      }
      await tester.tap(find.byKey(const Key('sidebar-toggle')));
      await tester.pumpAndSettle();
      expect(find.byKey(const Key('navigation-overlay')), findsOneWidget);
      await tester.tap(find.byKey(const Key('destination-settings')));
      await tester.pumpAndSettle();
      expect(find.byKey(const Key('appearance-dark')), findsOneWidget);
      expect(tester.takeException(), isNull);
    },
    variant: TargetPlatformVariant.only(TargetPlatform.macOS),
  );

