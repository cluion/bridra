  testWidgets('shows progress and replaces a previous response', (
    tester,
  ) async {
    final pending = Completer<GreetingResult>();
    final backend = FakeBackend(
      onGreet: (request, _) async {
        return request.name == 'Second' ? pending.future : greetingFor(request);
      },
    );
    await tester.pumpWidget(StarterApp(connector: () async => backend));
    await tester.pumpAndSettle();
    final field = find.byKey(const Key('name-field'));
    final button = find.byKey(const Key('call-button'));
    await tester.enterText(field, 'First');
    await tester.ensureVisible(button);
    await tester.tap(button);
    await tester.pumpAndSettle();
    expect(find.text('Hello, First!'), findsOneWidget);
    await tester.ensureVisible(field);
    await tester.enterText(field, 'Second');
    await tester.ensureVisible(button);
    await tester.tap(button);
    await tester.pump();
    expect(find.text('Sending…'), findsOneWidget);
    expect(find.text('Hello, First!'), findsNothing);
    expect(tester.widget<FilledButton>(button).onPressed, isNull);
    pending.complete(greetingFor(const GreetingRequest(name: 'Second')));
    await tester.pumpAndSettle();
    expect(find.text('Hello, Second!'), findsOneWidget);
  });

