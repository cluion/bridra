  testWidgets('copies real development commands from the guide', (
    tester,
  ) async {
    String? copied;
    tester.binding.defaultBinaryMessenger.setMockMethodCallHandler(
      SystemChannels.platform,
      (call) async {
        if (call.method == 'Clipboard.setData') {
          copied = (call.arguments as Map)['text'] as String;
        }
        return null;
      },
    );
    addTearDown(
      () => tester.binding.defaultBinaryMessenger.setMockMethodCallHandler(
        SystemChannels.platform,
        null,
      ),
    );
    await tester.pumpWidget(StarterApp(connector: () async => FakeBackend()));
    await tester.pumpAndSettle();
    await tester.tap(find.byIcon(Icons.menu_book_outlined));
    await tester.pumpAndSettle();
    final copy = find.byTooltip('Copy make doctor');
    await tester.ensureVisible(copy);
    await tester.tap(copy);
    await tester.pumpAndSettle();
    expect(copied, 'make doctor');
    expect(find.text('Copied make doctor'), findsOneWidget);
    expect(find.byType(SnackBar), findsNothing);
    final toast = find.byKey(const Key('app-toast'));
    expect(
      tester.getTopLeft(toast).dy,
      greaterThan(
        tester.getBottomLeft(find.byKey(const Key('window-toolbar'))).dy,
      ),
    );
    expect(tester.getTopLeft(toast).dy, lessThan(100));
    await tester.pump(const Duration(seconds: 3));
    await tester.pumpAndSettle();
    expect(toast, findsNothing);
  });

