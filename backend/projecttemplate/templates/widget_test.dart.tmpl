  testWidgets(
    'collapses the sidebar without changing appearance or losing the request',
    (tester) async {
      tester.view.physicalSize = const Size(1280, 820);
      tester.view.devicePixelRatio = 1;
      addTearDown(tester.view.resetPhysicalSize);
      addTearDown(tester.view.resetDevicePixelRatio);
      final backend = FakeBackend();
      await tester.pumpWidget(StarterApp(connector: () async => backend));
      await tester.pumpAndSettle();
      await tester.enterText(find.byKey(const Key('name-field')), 'Collapse');
      await tester.tap(find.byKey(const Key('call-button')));
      await tester.pumpAndSettle();
      final collapse = find.byTooltip('Collapse sidebar');
      expect(
        tester.getTopLeft(find.byKey(const Key('navigation-forward'))).dx,
        greaterThan(
          tester.getTopLeft(find.byKey(const Key('navigation-back'))).dx,
        ),
      );
      expect(
        tester.getTopLeft(collapse).dx,
        greaterThan(
          tester.getTopLeft(find.byKey(const Key('navigation-forward'))).dx,
        ),
      );
      expect(
        tester.getTopLeft(collapse).dy,
        lessThan(
          tester.getTopLeft(find.byKey(const Key('destination-settings'))).dy,
        ),
      );
      await tester.tap(collapse);
      await tester.pump();
      await tester.pump(const Duration(milliseconds: 80));
      final animatedWidth = tester
          .getSize(find.byKey(const Key('desktop-navigation')))
          .width;
      expect(animatedWidth, greaterThan(64));
      expect(animatedWidth, lessThan(240));
      expect(tester.takeException(), isNull);
      await tester.pumpAndSettle();
      expect(
        tester.getSize(find.byKey(const Key('desktop-navigation'))).width,
