  testWidgets('retries a failed sidecar connection', (tester) async {
    var attempts = 0;
    final backend = FakeBackend();
    await tester.pumpWidget(
      StarterApp(
        connector: () async {
          attempts++;
          if (attempts == 1) throw StateError('launch failed');
          return backend;
        },
      ),
    );
    await tester.pumpAndSettle();

    expect(find.byKey(const Key('runtime-status')), findsNothing);
    expect(find.byKey(const Key('retry-button')), findsOneWidget);

    final retryButton = find.byKey(const Key('retry-button'));
    await tester.ensureVisible(retryButton);
    await tester.tap(retryButton);
    await tester.pumpAndSettle();

    expect(attempts, 2);
    expect(find.byKey(const Key('retry-button')), findsNothing);
    await tester.tap(find.byKey(const Key('destination-runtime')));
    await tester.pumpAndSettle();
    expect(find.text('Ready'), findsOneWidget);
  });

