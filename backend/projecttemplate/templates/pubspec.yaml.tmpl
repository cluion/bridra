name: {{.ProjectName}}
description: {{quote .Description}}
publish_to: 'none'
version: 0.1.0+1

environment:
  sdk: ^3.12.2

dependencies:
  flutter:
    sdk: flutter
  {{.BridraFlutterPackage}}: {{quote .BridraFlutterVersion}}{{if .LocalDependencies}}

dependency_overrides:
  {{.BridraFlutterPackage}}:
    path: {{quote .BridraFlutterPath}}{{end}}

dev_dependencies:
  flutter_test:
    sdk: flutter
  integration_test:
    sdk: flutter
  flutter_lints: ^6.0.0

flutter:
  uses-material-design: true
