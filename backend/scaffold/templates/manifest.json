        {"source": "middleware.go.tmpl", "destination": "backend/app/middleware/{{.SnakeName}}_middleware.go"},
        {"source": "middleware_test.go.tmpl", "destination": "backend/app/middleware/{{.SnakeName}}_middleware_test.go"}
