    },
    "request": {
      "files": [
        {"source": "request.go.tmpl", "destination": "backend/app/requests/{{.SnakeName}}_request.go"},
        {"source": "request_test.go.tmpl", "destination": "backend/app/requests/{{.SnakeName}}_request_test.go"}
